# Root-owned /etc/operix/staging.env. This file contains identifiers, not passwords.
# All values are resolved on the host; GitHub receives no application secrets.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_ACCOUNT
ARTIFACT_BUCKET=REPLACE_WITH_OPERIX_PRIVATE_ARTIFACT_BUCKET
BACKUP_BUCKET=REPLACE_WITH_OPERIX_PRIVATE_BACKUP_BUCKET
SECRET_ID=operix/staging/runtime
APP_URL=https://operix.globalhightech.com
MAIL_FROM='Operix <no-reply@globalhightech.com>'
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
OPERIX_HTTP_PORT=18080
# Install only after inspecting Nginx: host (default) or docker-edge.
PROXY_MODE=host
