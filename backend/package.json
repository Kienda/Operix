{
  "name": "operix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Operix backend — multi-tenant business operations platform API, worker and shared packages. Global High Tech LLC.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @operix/api test:e2e",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @operix/database generate",
    "db:migrate": "pnpm --filter @operix/database migrate:dev",
    "db:deploy": "pnpm --filter @operix/database migrate:deploy",
    "db:seed": "pnpm --filter @operix/database seed",
    "db:reset": "pnpm --filter @operix/database reset",
    "db:studio": "pnpm --filter @operix/database studio",
    "infra:up": "docker compose -p operix -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -p operix -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -p operix -f infrastructure/docker/docker-compose.yml logs -f",
    "api:dev": "pnpm --filter @operix/api start:dev",
    "worker:dev": "pnpm --filter @operix/worker start:dev",
    "bootstrap": "pnpm install && pnpm infra:up && pnpm db:generate && pnpm db:deploy && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.13.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
