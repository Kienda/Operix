# =============================================================================
# Operix — Environment template
# Copy to .env at the repository root. Never commit a populated .env.
# =============================================================================

NODE_ENV=development
APP_NAME=Operix
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://operix:operix@localhost:55432/operix?schema=public
DATABASE_POOL_SIZE=10
# Separate low-privilege role used by the request-scoped RLS client.
DATABASE_APP_URL=postgresql://operix_app:operix_app@localhost:55432/operix?schema=public
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis / queues
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=operix
QUEUE_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Authentication
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=operix
JWT_AUDIENCE=operix-clients
MFA_ISSUER=Operix
PASSWORD_RESET_TTL=3600
INVITATION_TTL=604800
PORTAL_TOKEN_TTL=86400

# Argon2id tuning (OWASP baseline)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ENCRYPTION_KEY=replace-me-32-byte-base64-key-for-field-encryption==
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Object storage (S3-compatible: Cloudflare R2 or AWS S3) — private buckets only
# -----------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=operix-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL=900
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg,image/webp,image/heic,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# Email / SMS / WhatsApp / Push
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM="Operix <no-reply@operix.app>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

PUSH_DRIVER=log
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Documents / PDF
# -----------------------------------------------------------------------------
PDF_ENGINE=pdfkit
DOCUMENT_VERIFY_BASE_URL=https://verify.operix.app
DOCUMENT_RETENTION_DAYS=3650

# -----------------------------------------------------------------------------
# Maps / geo
# -----------------------------------------------------------------------------
MAPS_PROVIDER=mapbox
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
DEFAULT_GEOFENCE_RADIUS_M=150
GPS_MAX_ACCURACY_M=100

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=operix-api
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Platform bootstrap (seed only)
# -----------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=admin@globalhightech.com
PLATFORM_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_DATA=true
